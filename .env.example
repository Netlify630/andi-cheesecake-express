# Copy to .env (local) or set these in your host's environment variables (Vercel).
# Point these at ANY Supabase project you control — no Lovable services required.

# Client-side (must be prefixed with VITE_ to reach the browser bundle)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"

# Server-side (server functions / SSR)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"
# Only needed for the admin dashboard's member list (bypasses RLS — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
